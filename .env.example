# Password for the Compose `db` service (plain text here).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pocket_ledger

# Used by the api container. Host must be `db` (the Compose service name).
# If the password has @ : / # ? etc., URL-encode it in DATABASE_URL only.
DATABASE_URL=postgres://postgres:change-me@db:5432/pocket_ledger

ADMIN_USERNAME=admin
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

# Optional: publish Postgres on the host (default 5433).
# DB_PORT=5433
